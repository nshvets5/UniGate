{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "http://localhost:8081/realms/unigate",
    "Audience": "unigate-api",
    "RequireHttpsMetadata": false,
    "ProviderName": "keycloak"
  },
  "ConnectionStrings": {
    "MainDb": ""
  },
  "Timetable": {
    "Sync": {
      "Enabled": true,
      "RunOnStartup": true,
      "IntervalSeconds": 300,
      "JitterSeconds": 10
    }
  },
  "Notifications": {
    "Email": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "",
      "FromEmail": "",
      "FromName": "UniGate",
      "TimeoutSeconds": 15
    },
    "Admin": {
      "Recipients": []
    }
  },
  "Keycloak": {
    "Admin": {
      "BaseUrl": "http://localhost:8081",
      "Realm": "unigate",
      "TokenRealm": "unigate",
      "ClientId": "",
      "ClientSecret": "",
      "DefaultClientId": "unigate-api",
      "DefaultRedirectUri": ""
    }
  },
  "MobileCredential": {
    "Issuer": "unigate-api",
    "Audience": "unigate-reader",
    "SigningKey": "",
    "LifetimeSeconds": 60,
    "RefreshAfterSeconds": 30,
    "ClockSkewSeconds": 5
  }
}